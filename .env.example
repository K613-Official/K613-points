# --- Network (override for Arbitrum Sepolia) ---
# Monad mainnet=143 ; Arbitrum Sepolia=421614
CHAIN_ID=
CHAIN_NAME=
NATIVE_CURRENCY_SYMBOL=
RPC_URL=
# Leave blank to use canonical 0xcA11bde05977b3631167028862bE2a173976CA11
# (works on Arbitrum Sepolia and most chains); override only if different.
MULTICALL3_ADDRESS=

# --- Data sources ---
SUBGRAPH_URL=
AAVE_ORACLE_ADDRESS=

# --- Contracts (K613-Token deployment on the target chain) ---
K613S1_ADDRESS=
DISTRIBUTOR_ADDRESS=

# --- Operator (only needed for post-root) ---
OPERATOR_PRIVATE_KEY=

# --- Season ---
# Unix seconds of week-1 start; required by snapshot/build-tree
SEASON_1_START_TIMESTAMP=

# --- Galxe (only for build-galxe-bonus) ---
# API URL default = https://graphigo.prd.galaxy.eco/query (leave blank to use it)
GALXE_API_URL=
GALXE_ACCESS_TOKEN=
GALXE_SPACE_ID=86004
GALXE_CAMPAIGN_IDS=

LOG_LEVEL=
